# MyClaw 配置文件
# 文档: https://github.com/nxajh/MyClaw
#
# 路径布局（storage-layout redesign）：
#   base_dir     系统数据根（默认 ~/.myclaw；sessions/users/jobs/memory/
#                skills/agents/backups/state 全部派生自它，不可单独配置）
#   workspace_dir agent 工作台（默认 {base_dir}/workspace）

workspace_dir = "~/.myclaw/workspace"

# ── 全局默认 ───────────────────────────────────────────────────────

[defaults]
model = "gpt-4o"

[logging]
level = "info"

# ── Provider: OpenAI ───────────────────────────────────────────────

[providers.openai]
api_key = "${OPENAI_API_KEY}"

[providers.openai.chat]
base_url = "https://api.openai.com"
user_agent = "MyClaw/0.1"

[providers.openai.chat.models.gpt-4o]
input = ["text", "image"]
output = ["text"]
context_window = 128000
max_output_tokens = 16384

[providers.openai.chat.models.gpt-4o.pricing]
input = 2.5
output = 10.0
cache_read = 1.25

[providers.openai.chat.models.gpt-4o-mini]
input = ["text", "image"]
output = ["text"]
context_window = 128000
max_output_tokens = 16384

[providers.openai.chat.models.gpt-4o-mini.pricing]
input = 0.15
output = 0.6
cache_read = 0.075

[providers.openai.embedding]
base_url = "https://api.openai.com"

[providers.openai.embedding.models.text-embedding-3-small]
dimensions = 1536

[providers.openai.embedding.models.text-embedding-3-small.pricing]
input = 0.02

[providers.openai.image_generation]
base_url = "https://api.openai.com"

[providers.openai.image_generation.models.dall-e-3]

[providers.openai.image_generation.models.dall-e-3.pricing]
per_unit = 0.04

[providers.openai.tts]
base_url = "https://api.openai.com"

[providers.openai.tts.models.tts-1]

[providers.openai.tts.models.tts-1.pricing]
per_unit = 15.0

# ── Provider: MiniMax ──────────────────────────────────────────────

[providers.minimax]
api_key = "${MINIMAX_API_KEY}"

[providers.minimax.chat]
base_url = "https://api.minimaxi.chat"

[providers.minimax.chat.models.minimax-m2.7]
input = ["text", "image"]
output = ["text"]
context_window = 131072
max_output_tokens = 32768

[providers.minimax.chat.models.minimax-m2.7.pricing]
input = 1.0
output = 2.0

# ── Provider: GLM (智谱) ──────────────────────────────────────────

[providers.glm]
api_key = "${GLM_API_KEY}"
auth_style = "bearer"

[providers.glm.chat]
base_url = "https://open.bigmodel.cn/api/paas"

[providers.glm.chat.models.glm-4-plus]
input = ["text", "image"]
output = ["text"]
context_window = 128000
reasoning = true

[providers.glm.chat.models.glm-4-plus.pricing]
input = 50.0
output = 50.0

[providers.glm.embedding]
base_url = "https://open.bigmodel.cn/api/paas"

[providers.glm.embedding.models.embedding-3]
dimensions = 2048

# ── Provider: Kimi (月之暗面) ──────────────────────────────────────

[providers.kimi]
api_key = "${KIMI_API_KEY}"

[providers.kimi.chat]
base_url = "https://api.moonshot.cn"

[providers.kimi.chat.models.moonshot-v1-8k]
input = ["text"]
output = ["text"]
context_window = 8192
max_output_tokens = 4096

[providers.kimi.chat.models.moonshot-v1-32k]
input = ["text"]
output = ["text"]
context_window = 32768
max_output_tokens = 8192

# ── Provider: Anthropic ────────────────────────────────────────────

[providers.anthropic]
api_key = "${ANTHROPIC_API_KEY}"
auth_style = "x_api_key"

[providers.anthropic.chat]
base_url = "https://api.anthropic.com"

[providers.anthropic.chat.models.claude-sonnet-4-20250514]
input = ["text", "image"]
output = ["text"]
context_window = 200000
max_output_tokens = 8192

[providers.anthropic.chat.models.claude-sonnet-4-20250514.pricing]
input = 3.0
output = 15.0
cache_read = 0.3

# ── Provider: Xiaomi MiMo ─────────────────────────────────────────

[providers.xiaomi]
api_key = "${XIAOMI_API_KEY}"
auth_style = "bearer"

[providers.xiaomi.chat]
base_url = "https://api.xiaomimimo.com/anthropic"

[providers.xiaomi.chat.models.mimo-7b]
input = ["text"]
output = ["text"]
context_window = 131072
reasoning = true

# ── 路由配置 ───────────────────────────────────────────────────────

[routing.chat]
strategy = "fallback"
models = ["gpt-4o", "minimax-m2.7"]

[routing.embedding]
strategy = "fixed"
models = ["text-embedding-3-small"]

# ── 通道配置 ───────────────────────────────────────────────────────

[channels.telegram]
bot_token = "${TELEGRAM_BOT_TOKEN}"
allowed_users = ["*"]
mention_only = false
enabled = true
ack_reactions = true
approval_timeout_secs = 120

# [channels.wechat]
# api_base = "https://ilink.bot.weixin.qq.com"
# bot_token = "${WECHAT_BOT_TOKEN}"
# aes_key = "${WECHAT_AES_KEY}"
# allowed_users = ["*"]
# enabled = true

# ── Agent 配置 ─────────────────────────────────────────────────────

[agent]
max_tool_calls = 100
max_history = 200
autonomy_level = "default"
tool_timeout_secs = 180
# Stream chunk timeout: max seconds to wait for next chunk from LLM
stream_chunk_timeout_secs = 90

[agent.prompt]
compact = false
native_tools = true
bootstrap_max_chars = 8000
model_name = "gpt-4o"
channel_name = "telegram"

# ── Memory 配置 ────────────────────────────────────────────────────

[memory]
storage = "sqlite"
db_path = "memory.db"
search_limit = 10
consolidation_age_days = 30

# ── MCP 服务器 ─────────────────────────────────────────────────────

# [[mcp_servers]]
# name = "filesystem"
# command = "npx"
# args = ["mcp-server-filesystem", "/tmp"]

# ── 子 Agent（多 Agent 模式）──────────────────────────────────────
#
# Sub-agents are now defined as AGENT.md files in workspace/agents/<name>/.
# See workspace/agents/coder/AGENT.md for an example.
#
# To add a new sub-agent:
#   1. Create workspace/agents/<name>/AGENT.md
#   2. Add YAML front matter with name, description, tools, max_tool_calls
#   3. Write the system prompt as Markdown body
#   4. Restart MyClaw daemon (or reload if hot-reload is enabled)

# ── 递归委托（Delegation）配置 ─────────────────────────────────────
#
# max_depth: 最大委托嵌套深度，主 agent 记为第 1 层。
#   默认 3：允许 main → sub → sub-sub，拒绝第 4 层及更深。
#   超限时 agent_delegate 在工具层直接返回错误，不产生挂起任务。
#   设为 1 即完全禁止子 agent 委托。

[delegation]
max_depth = 3

# ── Skills（跨 agent 通用 skill 目录，issue #83） ────────────────────
#
# include_agents_dir: 除 `~/.myclaw/skills`（本地定制，唯一可写区）外
#   是否额外加载 `~/.agents/skills`（vercel-labs `skills` CLI 等跨 agent
#   工具的通用分发目录）。同名冲突时本地目录覆盖，并打一条 warn 日志。
#   默认 true；不想被共享库隐式影响时设为 false。

[skills]
include_agents_dir = true

# ── Shell 环境修补（issue #84） ─────────────────────────────────────
#
# 工具 shell 默认继承 daemon 进程环境；daemon 由 systemd user unit 启动时
# 不经过任何登录/交互 shell，`.bashrc` 里追加的用户 PATH（npm-global、
# nvm、pyenv、Homebrew 等）对它不可见。
#
# login_env_probe: 启动时探测一次 `$SHELL -lic 'env -0'`（`-i` 让 rc 文件
#   里的交互区代码块也执行——大多数发行版 `.bashrc` 开头就是非交互早退，
#   缺 `-i` 会漏掉 npm-global/nvm/pyenv 这类恰好写在交互区的 PATH 追加），
#   把结果并入工具 shell 的 PATH（只填缺口——daemon 自身已有的同名变量
#   永远优先，不会被探测结果覆盖）。要求 `$SHELL` 是 `/etc/shells` 里的
#   绝对路径，探测带超时与输出上限，失败只 warn 一次并降级为仅用系统
#   标准目录兜底。默认 true。
#   注：探测到的目录追加在系统标准目录*之后*，无法用来 shadow 同名的
#   `/usr/bin` 命令；需要这种优先级时用下面的 path_extra。
# path_extra / env: 兜底 ①②都覆盖不到时的最终逃生口，优先级最高。

[shell]
login_env_probe = true
# path_extra = ["/opt/custom/bin"]
# [shell.env]
# FOO = "bar"
